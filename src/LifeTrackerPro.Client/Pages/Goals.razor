@page "/goals"
@inject DashboardService DashboardSvc

<PageTitle>Goals — LifeTracker Pro</PageTitle>

<div class="page-enter">
    <h1 class="lt-page-heading">Your <span class="accent">Goals</span></h1>
    <p class="lt-page-subtitle">Track your ambitions across every time horizon</p>

    @if (_loading)
    {
        <div style="text-align:center; padding:40px; color:var(--ink-muted); font-family:var(--font-mono);">Loading...</div>
    }
    else
    {
        <!-- Streaks -->
        <div class="lt-grid-3" style="margin-bottom:30px;">
            <div class="lt-card accent" style="text-align:center; padding:20px;">
                <div style="font-size:32px; margin-bottom:6px;">🔥</div>
                <div style="font-size:28px; font-weight:700; color:var(--crail); font-family:var(--font-serif);">@_streak days</div>
                <div style="font-size:10px; color:var(--ink-muted); font-family:var(--font-mono); text-transform:uppercase; letter-spacing:0.12em; margin-top:4px;">Logging Streak</div>
            </div>
            <div class="lt-card" style="text-align:center; padding:20px;">
                <div style="font-size:32px; margin-bottom:6px;">◉</div>
                <div style="font-size:28px; font-weight:700; color:var(--crail); font-family:var(--font-serif);">@_daysLogged</div>
                <div style="font-size:10px; color:var(--ink-muted); font-family:var(--font-mono); text-transform:uppercase; letter-spacing:0.12em; margin-top:4px;">Days Logged</div>
            </div>
            <div class="lt-card" style="text-align:center; padding:20px;">
                <div style="font-size:32px; margin-bottom:6px;">◎</div>
                <div style="font-size:28px; font-weight:700; color:var(--crail); font-family:var(--font-serif);">@_totalHours h</div>
                <div style="font-size:10px; color:var(--ink-muted); font-family:var(--font-mono); text-transform:uppercase; letter-spacing:0.12em; margin-top:4px;">Hours Tracked</div>
            </div>
        </div>

        <!-- Category Goals — derived from this month's data -->
        @if (_hoursPerCategory.Count > 0)
        {
            <div style="margin-bottom:28px;">
                <div class="lt-section-label"><span>Monthly Category Hours</span></div>
                @foreach (var cat in _hoursPerCategory.Take(6))
                {
                    <div class="lt-card" style="margin-bottom:10px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                            <span style="color:var(--ink); font-size:14px; font-family:var(--font-sans); font-weight:600;">@cat.CategoryName</span>
                            <span style="color:var(--crail); font-size:14px; font-weight:800; font-family:var(--font-mono);">@cat.Hours h</span>
                        </div>
                        <div class="lt-progress-track">
                            <div class="lt-progress-fill crail" style="width:@((int)cat.Percentage)%; background:@cat.Color;"></div>
                        </div>
                        <div style="font-size:10px; color:var(--ink-muted); font-family:var(--font-mono); margin-top:5px;">@cat.Percentage% of logged time</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="lt-card" style="text-align:center; padding:40px; color:var(--ink-muted);">
                <div style="font-family:var(--font-mono); font-size:12px; text-transform:uppercase; letter-spacing:0.1em;">Start logging daily to see goal progress</div>
            </div>
        }
    }
</div>

@code {
    private int _streak;
    private int _daysLogged;
    private int _totalHours;
    private List<CategoryHoursDto> _hoursPerCategory = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dash = await DashboardSvc.GetAsync("month");
            if (dash is not null)
            {
                _streak = dash.CurrentStreak;
                _daysLogged = dash.DaysLogged;
                _totalHours = dash.TotalLoggedHours;
                _hoursPerCategory = dash.HoursPerCategory;
            }
        }
        catch { }
        finally { _loading = false; }
    }
}
