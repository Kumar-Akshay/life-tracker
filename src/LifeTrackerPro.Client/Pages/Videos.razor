@page "/videos"
@inject VideoService VideoSvc

<PageTitle>Videos — LifeTracker Pro</PageTitle>

<div class="page-enter">
    <h1 class="lt-page-heading">Video <span class="accent">Learning</span></h1>
    <p class="lt-page-subtitle">Curate your learning journey with purpose</p>

    @if (_loading)
    {
        <div style="text-align:center; padding:40px; color:var(--ink-muted); font-family:var(--font-mono);">Loading...</div>
    }
    else
    {
        <!-- Stats -->
        <div class="lt-kpi-grid" style="margin-bottom:24px;">
            <div class="lt-card">
                <div class="lt-stat-label">Videos</div>
                <div class="lt-stat-value">@_videos.Count</div>
            </div>
            <div class="lt-card">
                <div class="lt-stat-label">In Progress</div>
                <div class="lt-stat-value">@_videos.Count(v => v.Status == "InProgress")</div>
            </div>
            <div class="lt-card">
                <div class="lt-stat-label">Hours</div>
                <div class="lt-stat-value">@(_videos.Sum(v => v.DurationMinutes) / 60)<span class="unit">h</span></div>
            </div>
            <div class="lt-card">
                <div class="lt-stat-label">Completed</div>
                <div class="lt-stat-value">@_videos.Count(v => v.Status == "Completed")</div>
            </div>
        </div>

        @if (_videos.Count == 0)
        {
            <div class="lt-card" style="text-align:center; padding:40px; color:var(--ink-muted);">
                <div style="font-size:32px; margin-bottom:12px;">🎬</div>
                <div style="font-family:var(--font-mono); font-size:12px; text-transform:uppercase; letter-spacing:0.1em;">No videos yet</div>
                <div style="font-size:13px; margin-top:6px;">Add your first course or video to start tracking</div>
            </div>
        }
        else
        {
            <!-- Kanban Columns -->
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:14px;">
                @foreach (var column in _kanban)
                {
                    <div class="lt-card">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
                            <div style="width:9px; height:9px; border-radius:50%; background:@column.StatusColor;"></div>
                            <span style="font-size:11px; color:var(--ink-soft); font-family:var(--font-mono); font-weight:700; text-transform:uppercase; letter-spacing:0.08em;">@column.Label</span>
                        </div>
                        @foreach (var item in column.Items)
                        {
                            <div style="padding:14px; border-radius:12px; background:var(--pampas); margin-bottom:8px; border:1px solid var(--border);">
                                <div style="font-size:13px; font-weight:700; color:var(--ink); font-family:var(--font-sans); margin-bottom:4px;">@item.Title</div>
                                <div style="font-size:10px; color:var(--ink-muted); font-family:var(--font-mono); margin-bottom:8px;">@item.Platform · @item.DurationFormatted</div>
                                @if (item.Status == "InProgress")
                                {
                                    <div style="margin-bottom:8px;">
                                        <div class="lt-progress-track" style="height:5px;">
                                            <div class="lt-progress-fill crail" style="width:@item.ProgressPercent%;"></div>
                                        </div>
                                        <span style="font-size:9px; color:var(--ink-muted); font-family:var(--font-mono);">@item.ProgressPercent%</span>
                                    </div>
                                }
                                @if (item.Tags.Count > 0)
                                {
                                    <div style="display:flex; gap:4px; flex-wrap:wrap;">
                                        @foreach (var tag in item.Tags)
                                        {
                                            <span class="lt-tag crail">@tag</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<VideoDto> _videos = new();
    private bool _loading = true;

    private record KanbanCol(string Label, string StatusColor, List<VideoDto> Items);

    private List<KanbanCol> _kanban = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _videos = await VideoSvc.GetAllAsync();
            _kanban = new()
            {
                new("To Start", "#7A7570", _videos.Where(v => v.Status == "ToStart").ToList()),
                new("In Progress", "#C49A2D", _videos.Where(v => v.Status == "InProgress").ToList()),
                new("Completed", "#5B8C51", _videos.Where(v => v.Status == "Completed").ToList())
            };
        }
        catch { }
        finally { _loading = false; }
    }
}
